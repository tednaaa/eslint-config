{
	"name": "@tednaaa/eslint-config",
	"type": "module",
	"version": "0.0.0",
	"description": "Personal ESLint config built on @antfu/eslint-config",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/tednaaa/eslint-config"
	},
	"keywords": [
		"eslint-config",
		"eslint",
		"antfu",
		"vue"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"CHANGELOG.md",
		"README.md",
		"dist"
	],
	"scripts": {
		"prepare": "lefthook install",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"eslint": ">=9.10.0"
	},
	"dependencies": {
		"@antfu/eslint-config": "9.5.1",
		"local-pkg": "1.2.1"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.3",
		"eslint": "10.11.0",
		"jiti": "2.7.0",
		"lefthook": "2.2.1",
		"publint": "0.3.21",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"vitest": "4.1.11"
	}
}
